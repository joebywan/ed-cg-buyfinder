    def bump_font(self, delta):
        new = min(FONT_MAX, max(FONT_MIN, self.fs + delta))
        if new == self.fs:
            return
        self.fs = new
        self.font_lbl.configure(text=str(new))
        self._style()                       # restyle every widget class
        self._apply_col_widths()
        self._fit_window()
        for e in self.entries:              # ttk.Entry font is per-widget
            e.configure(font=self._fonts()["mono"])
        for t in (self.t_mixed, self.t_single):
            t.tag_configure("head", foreground=OR, font=self._fonts()["bold"])
        if self.data:                       # redraw so rows pick up the metrics
            self._fill_mixed()
            self._fill_single()
        self.cfg["font_size"] = new
        save_config(self.cfg)

    # -- journal ---------------------------------------------------------
    def _init_journal(self):
        self._save_cal()                # keep samples learned since last save
        self._poll_token = getattr(self, "_poll_token", 0) + 1
        self.watcher = None
        self.cal = None
        self.sender = None
        if journal is None:
            self.cal_lbl.configure(text="journal module not found")
            return
        try:
            cal = journal.Calibration(self.cfg.get("calibration"))
            w = journal.JournalWatcher(self.cfg.get("journal_dir"), cal)
            if not w.dir:
                self.cal_lbl.configure(text="no Elite journals found")
                return
            w.prime()
            w.on_docked = self._on_docked
            w.on_event = self._on_journal_event
            if eddn:
                self.sender = eddn.Sender(self.cfg.get("eddn_seen"))
            self.watcher, self.cal = w, w.cal
            self._show_cal()
            self.root.after(3000, self._poll_journal, self._poll_token)
        except Exception as e:
            self.cal_lbl.configure(text="journal error: %s" % e)

    def set_status(self, text, colour=None):
        self.status.configure(text=text, foreground=colour or DIM)

    def _show_cal(self):
        if self.cal:
            self.cal_lbl.configure(text="TIMINGS  " + self.cal.summary())

    def _poll_journal(self, token=None):
        if token is not None and token != self._poll_token:
            return                      # superseded by a newer poll chain
        if self.watcher:
            try:
                self.watcher.poll()
                self._show_cal()
            except Exception:
                pass
            self.root.after(3000, self._poll_journal, self._poll_token)

    def _on_journal_event(self, e):
        """A Market event means the game just rewrote Market.json."""
        if e.get("event") != "Market" or not self.v_eddn.get():
            return
        if not (eddn and self.sender and self.watcher):
            return
        path = os.path.join(self.watcher.dir, "Market.json")
        args = (path, self.watcher.commander, self.watcher.horizons,
                self.watcher.odyssey, self.watcher.gameversion,
                self.watcher.gamebuild)

        def worker():
            ok, msg = self.sender.maybe_send(*args)
            self.q.put(("eddn", (ok, msg)))

        # The upload can block for 20s; never run it on the UI thread.
        threading.Thread(target=worker, daemon=True).start()

    def _on_docked(self, station, system):
        """Docking at the CG station means a run just ended - refresh."""
        self._save_cal()
        if station == CG_STATION and not self.busy:
            self.status.configure(
                text="Docked at %s - refreshing for the next run..." % station,
                foreground=OR)
            self.search()          # _finish() republishes state at rank 1

    def _save_cal(self):
        if getattr(self, "cal", None):
            self.cfg["calibration"] = self.cal.to_dict()
            if self.watcher and self.watcher.dir:
                self.cfg["journal_dir"] = self.watcher.dir
            save_config(self.cfg)

    # -- behaviour -------------------------------------------------------
    def _params(self):
        def num(var, default, cast=float):
            try:
                return cast(var.get().strip())
            except ValueError:
                return default
        return {
            "hold": max(1, num(self.v_hold, 784, int)),
            "range": max(1.0, num(self.v_range, 30.0)),
            "jump_empty": max(1.0, num(self.v_je, 38.0)),
            "jump_laden": max(1.0, num(self.v_jl, 18.0)),
            "min_supply": max(0, num(self.v_ms, 200, int)),
            "carriers": bool(self.v_fc.get()),
            "verify_edsm": bool(self.cfg.get("verify_edsm", True)),
            "verify_top": int(self.cfg.get("verify_top", 18)),
        }

    def search(self):
        if self.busy:
            return
        self.busy = True
        self.go.state(["disabled"])
        self.pbar["value"] = 0
        self.status.configure(text="Starting...", foreground=DIM)
        threading.Thread(target=self._work, args=(self._params(),),
                         daemon=True).start()

    def _work(self, params):
        try:
            rows, cg, cg_ls = build_rows(
                params, lambda d, t, n: self.q.put(("prog", (d, t, n))),
                cal=self.cal)
            rows.sort(key=lambda r: -r["cr_per_min"])
            self.q.put(("done", {
                "rows": rows, "mixed": build_mixed(rows, params["hold"]),
                "cg": cg, "cg_ls": cg_ls, "params": params,
                "fetched_at": time.time()}))
        except Exception as e:
            self.q.put(("err", "%s: %s" % (type(e).__name__, e)))

    def _drain(self):
        try:
            self._drain_once()
        finally:
            # Must always reschedule: an error inside _finish used to leave the
            # UI frozen with SEARCH disabled for the rest of the session.
            self.root.after(80, self._drain)

    def _drain_once(self):
        try:
            while True:
                kind, payload = self.q.get_nowait()
                if kind == "prog":
                    d, t, n = payload
                    self.pbar["value"] = d
                    self.status.configure(
                        text="Fetching %d/%d commodities  -  %s" % (d, t, n),
                        foreground=DIM)
                elif kind == "done":
                    self._finish(payload)
                elif kind == "eddn":
                    ok, msg = payload
                    if msg != "already sent":
                        self.set_status("EDDN: %s" % msg, None if ok else BAD)
                        self.cfg["eddn_seen"] = self.sender.to_list()
                        save_config(self.cfg)
                elif kind == "err":
                    self.busy = False
                    self.go.state(["!disabled"])
                    self.status.configure(text=payload, foreground=BAD)
        except queue.Empty:
            pass
        except Exception as e:
            self.busy = False
            try:
                self.go.state(["!disabled"])
                self.set_status("display error: %s" % e, BAD)
            except Exception:
                pass

    def _finish(self, d, from_cache=False):
        self.data = d
        self.busy = False
        self.go.state(["!disabled"])
        self.pbar["value"] = len(COMMODITIES)
        self.cg_lbl.configure(text="%s  -  %s  -  %s Ls from arrival"
                              % (CG_STATION, CG_SYSTEM, f"{d['cg_ls']:,.0f}"))
        order = sorted(d["cg"], key=lambda k: -d["cg"][k]["sell"])
        self.prices.configure(
            text="CG PAYS   " + "    ".join(
                "%s %s" % (k, f"{d['cg'][k]['sell']:,}") for k in order))
        self.status.configure(
            text="%s sources across %d commodities%s"
                 % (f"{len(d['rows']):,}", len(d["cg"]),
                    "  (cached, %s old)" % age_phrase(d.get("fetched_at"))
                    if from_cache else ""), foreground=DIM)
        self._fill_mixed()
        self._fill_single()
        write_state(d["mixed"], keep_index=0)
        if not from_cache:
            save_cache(d)

    def _fill_mixed(self):
        t = self.t_mixed
        t.delete(*t.get_children())
        self._forget_rows(t)
        for i, p in enumerate(self.data["mixed"][:40]):
            carrier = "  [CARRIER]" if p["carrier"] else ""
            short = ("  -  %dt short" % p["short"]) if p["short"] else ""
            parent = t.insert(
                "", "end", open=(i < 5),
                values=("%d. %s%s" % (i + 1, p["station"], carrier),
                        "%s  -  %.1f ly  -  %s Ls  -  data %s%s"
                        % (p["system"], p["ly"], f"{p['ls']:,}",
                           age_text(p["updated"]), short),
                        "%st" % f"{p['tonnes']:,}", "",
                        f"{p['total']:,}", f"{p['cr_per_min']:,}"),
                tags=("head",) if i else ("head", "top"))
            self._remember(t, parent, p["system"])
            for m in p["mix"]:
                child = t.insert(parent, "end", values=(
                    "      %s" % m["commodity"],
                    "buy %s" % f"{m['buy']:,}",
                    "%st" % f"{m['tonnes']:,}",
                    "+%s" % f"{m['profit_per_t']:,}",
                    f"{m['value']:,}", ""), tags=("child",))
                self._remember(t, child, p["system"])

    def _sort_by(self, col):
        if self.sort_key == col:
            self.sort_desc = not self.sort_desc
        else:
            self.sort_key, self.sort_desc = col, True
        self._fill_single()

    def _fill_single(self):
        t = self.t_single
        t.delete(*t.get_children())
        self._forget_rows(t)
        if not self.data:
            return
        k, desc = self.sort_key, self.sort_desc
        rows = sorted(self.data["rows"], key=lambda r: r[k], reverse=desc)[:400]
        for k2, lbl, _w, _a in self.SINGLE_COLS:
            arrow = ("  v" if desc else "  ^") if k2 == k else ""
            t.heading(k2, text=lbl + arrow)
        for i, r in enumerate(rows):
            stn = r["station"] + ("  [FC]" if r["carrier"] else "")
            tags = [age_tag(r["updated"])]
            if i % 2:
                tags.append("odd")
            iid = t.insert("", "end", values=(
                r["commodity"], stn, r["system"], "%.1f" % r["ly"],
                f"{r['ls']:,}", f"{r['supply']:,}", r["loads_available"],
                f"{r['buy']:,}", f"{r['profit_per_t']:,}",
                "%dm" % round(r["trip_minutes"]), f"{r['cr_per_min']:,}",
                r["t_per_min"], age_text(r["updated"]),
                "EDSM" if r.get("edsm") else "spansh"), tags=tags)
            self._remember(t, iid, r["system"])


def main():
    autosearch = "--no-autosearch" not in sys.argv
    try:
        root = tk.Tk()
    except tk.TclError as e:
        sys.exit("Cannot open a display (%s). This is a desktop app - run it "
                 "on the machine's desktop session." % e)
    App(root, autosearch=autosearch)
    root.mainloop()


if __name__ == "__main__":
    main()
