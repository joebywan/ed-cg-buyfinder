            f, text="%s  -  %s" % (CG_STATION, CG_SYSTEM), style="Sub.TLabel")
        self.cg_lbl.pack(side="left", padx=(14, 0))

    def _num(self, parent, label, default, width=7):
        box = ttk.Frame(parent, style="Panel.TFrame")
        box.pack(side="left", padx=(0, 14))
        ttk.Label(box, text=label, style="Cap.TLabel").pack(anchor="w")
        var = tk.StringVar(value=str(default))
        e = ttk.Entry(box, textvariable=var, width=width,
                      font=self._fonts()["mono"], justify="right")
        e.pack(anchor="w", pady=(2, 0))
        self.entries.append(e)
        return var

