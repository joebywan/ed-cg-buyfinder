# Age colouring. The old 21/120-day thresholds were written for casual
# trading; during a CG a three-week-old supply figure shown in green is a lie.
AGE_FRESH_DAYS = 2
AGE_STALE_DAYS = 7

# Landing pad required by ship, keyed on the journal's internal name.
# Unknown ships fall back to "L": large pads are a subset of what every
# station offers a small ship, so guessing large can only ever be
# over-restrictive, never strand you at a pad you cannot use.
