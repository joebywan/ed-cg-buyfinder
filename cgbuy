    def known_commodities(self, station, system):
        """Everything we can name, for the picker.

        The destination's own market is the useful set - it cannot buy what it
        does not trade - but EDSM only records goods it has seen, so the local
        Market.json (far more complete) and the current selection are folded
        in rather than leaving anything unreachable.
        """
        names = set()
        if verify is not None and station and system:
            try:
                import urllib.parse as _up
                d = verify._get(verify.EDSM_MARKET.format(
                    sys=_up.quote(system), stn=_up.quote(station)))
                names.update(c["name"] for c in d.get("commodities", [])
                             if c.get("name"))
            except Exception:
                pass
        jd = self.watcher.dir if self.watcher else None
        if jd:
            try:
                with open(os.path.join(jd, "Market.json"),
                          encoding="utf-8", errors="replace") as fh:
                    mk = json.load(fh)
                for it in mk.get("Items", []):
                    n = it.get("Name_Localised") or it.get("Name")
                    if n and not n.startswith("$"):
                        names.add(n)
            except (OSError, ValueError):
                pass
        names.update(self.dest.get("commodities") or ())
        return sorted(names)

    def pick_commodities(self, station, system, current, on_ok):
        """A filterable checklist, rather than a comma-separated typing test."""
        win = tk.Toplevel(self.root)
        win.title("Choose commodities")
        win.configure(bg=BG)
        win.transient(self.root)
        f = self._fonts()

        chosen = set(current or ())
        allnames = []

        head = ttk.Label(win, text="Loading...", style="Dim.TLabel")
        head.pack(anchor="w", padx=14, pady=(12, 2))

        v_filter = tk.StringVar()
        ent = ttk.Entry(win, textvariable=v_filter, width=44, font=f["mono"])
        ent.pack(anchor="w", padx=14)
        ent.focus_set()

        wrap = ttk.Frame(win)
        wrap.pack(fill="both", expand=True, padx=14, pady=8)
        lb = tk.Listbox(wrap, width=46, height=18, bg=PANEL, fg=TXT,
                        selectbackground=SEL, selectforeground=OR,
                        font=f["mono"], activestyle="none",
                        highlightthickness=1, highlightbackground=LINE)
        sb = ttk.Scrollbar(wrap, orient="vertical", command=lb.yview)
        lb.configure(yscrollcommand=sb.set)
        lb.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")

        def shown():
            q = v_filter.get().strip().lower()
            return [n for n in allnames if q in n.lower()]

        def redraw(*_a):
            lb.delete(0, "end")
            for n in shown():
                lb.insert("end", "%s %s" % ("[x]" if n in chosen else "[ ]", n))
            head.configure(text="%d selected of %d  -  type to filter, click to "
                                "toggle" % (len(chosen), len(allnames)))

        def toggle(event):
            idx = lb.nearest(event.y)
            names = shown()
            if 0 <= idx < len(names):
                n = names[idx]
                chosen.discard(n) if n in chosen else chosen.add(n)
                top = lb.yview()[0]
                redraw()
                lb.yview_moveto(top)

        lb.bind("<Button-1>", toggle)
        v_filter.trace_add("write", redraw)

        bar = ttk.Frame(win)
        bar.pack(fill="x", padx=14, pady=(0, 12))

        def add_shown():
            chosen.update(shown()); redraw()

        def clear_shown():
            for n in shown():
                chosen.discard(n)
            redraw()

        ttk.Button(bar, text="ADD SHOWN", style="Alt.TButton",
                   command=add_shown).pack(side="left")
        ttk.Button(bar, text="REMOVE SHOWN", style="Alt.TButton",
                   command=clear_shown).pack(side="left", padx=6)
        ttk.Button(bar, text="CANCEL", style="Alt.TButton",
                   command=win.destroy).pack(side="right", padx=6)

        def ok():
            on_ok(sorted(chosen))
            win.destroy()

        ttk.Button(bar, text="USE THESE", style="Go.TButton",
                   command=ok).pack(side="right")
        win.bind("<Return>", lambda e: ok())
        win.bind("<Escape>", lambda e: win.destroy())

        def load():
            found = self.known_commodities(station, system)
            if not self.closing:
                self.q.put(("commodities", (found, redraw, allnames)))

        self._spawn(load)
        return win

    def _copy_dest_system(self):
        """Put the destination system on the clipboard, ready to paste into
        the galaxy map search."""
        system = self.dest.get("system")
        if not system:
            return
        try:
            self.root.clipboard_clear()
            self.root.clipboard_append(system)
            self.root.update_idletasks()
        except tk.TclError:
            self.set_status("could not reach the clipboard", BAD)
            return
        self.banner_copy.configure(text="COPIED")
        self.root.after(1800, lambda: self.banner_copy.configure(
            text="COPY SYSTEM"))
        self.set_status("copied  %s  - paste it into the galaxy map search"
                        % system, OR)

    def _dismiss_banner(self):
        # Session-only: a new launch while still unregistered reminds once
        # more, which is the last useful moment to mention it.
        self.banner_dismissed = True
        self._set_banner("")

    def _adopt_destination(self):
        """Take the destination from the CG this commander joined.

        Asking the user to type a station the game already knows about is
        work the tool should be doing. A destination they set by hand is
        never overridden.
        """
        if cgstanding is None or not self.watcher or not self.watcher.dir:
            return
        if self.cfg.get("dest_manual"):
            return
        if self.dest.get("station") and self.cfg.get("dest"):
            return                              # already chosen, leave it

        def work():
            try:
                hist = cgstanding.read_history(self.watcher.dir)
                found, others = cgstanding.suggest_destination(
                    hist, cgstanding.fetch_live())
                if found and found.get("station") and not self.closing:
                    found = dict(found, alternatives=len(others))
                    self.q.put(("dest", found))
            except Exception:
                pass

        self._spawn(work)

    def _apply_destination(self, found):
        if not found or not found.get("commodities"):
            # Without a commodity list there is nothing to search for; leave
            # the fields for the user rather than half-configuring.
            if found:
                self.set_status(
                    "Joined CG: %s (%s) - no commodity list; set it in Settings"
                    % (found["station"], found["system"]), WARN)
            return
        self.dest = dict(found)
        self.cfg["dest"] = self.dest
        save_config(self.cfg)
        self.cg_lbl.configure(text="%s  -  %s" % (self.dest["station"],
                                                  self.dest["system"]))
        self._update_title()
        alts = found.get("alternatives") or 0
        more = ("  (+%d other trade CG%s - see SETTINGS)"
                % (alts, "" if alts == 1 else "s")) if alts else ""
        if found.get("source", "").startswith("live CG"):
            # Hauling for a goal you have not signed up to contributes
            # nothing, so say what to do before they fly anywhere.
            expiry = found.get("expiry") or ""
            self._set_banner(
                "We've found a trading community goal you'll need to register "
                "for, at %s in %s.  Head there and sign up at the goal board - "
                "anything you deliver before registering won't count.  "
                "Meanwhile we're working out your best trade routes.  "
                "Use COPY SYSTEM to paste it into the galaxy map.%s%s"
                % (self.dest["station"], self.dest["system"],
                   "  Goal ends %s." % expiry[:16] if expiry else "", more))
            self.set_status("Live CG at %s, %s - register there to contribute"
                            % (self.dest["station"], self.dest["system"]), WARN)
            self._notify(
                "Trading community goal found",
                "Register at %s in %s before hauling - deliveries made before "
                "you sign up don't count. Routes are being worked out now."
                % (self.dest["station"], self.dest["system"]), "normal")
        else:
            self._set_banner("")
            self.set_status(
                "Destination from your joined CG: %s, %s (%d commodities)%s"
                % (self.dest["station"], self.dest["system"],
                   len(self.dest["commodities"]), more))
        if not self.busy:
            self.search()

    def refresh_standing(self):
        """Where you stand in the goal, from your journal + Frontier's feed."""
        if cgstanding is None or not self.watcher or not self.watcher.dir:
            return
        def work():
            try:
                hist = cgstanding.read_history(self.watcher.dir)
                live = next((g for g in cgstanding.fetch_live()
                             if g.get("is_trade")), None)
                if not self.closing:
                    self.q.put(("standing", cgstanding.standing(hist, live)))
            except Exception:
                pass
        self._spawn(work)

    def _effort(self, tonnes):
        """Turn a tonnage gap into runs and time, which is what you act on.

        A number of tonnes says nothing about whether that is one more run or
        twenty. Runs come from the hold you are actually flying; time from the
        best current plan's measured round trip.
        """
        try:
            hold = max(1, int(float(self.v_hold.get().strip())))
        except (ValueError, AttributeError):
            hold = 1
        runs = int(math.ceil(tonnes / float(hold))) if tonnes > 0 else 0
        if runs <= 0:
            return "you're there"

        top = (self.data or {}).get("mixed") or []
        mins = top[0]["trip_minutes"] if top else None
        if not mins:
            return "%d run%s" % (runs, "" if runs == 1 else "s")

        total = runs * mins
        if total < 90:
            clock = "%d min" % round(total)
        else:
            h, m = divmod(int(round(total)), 60)
            clock = "%dh %02dm" % (h, m)
        return "%d run%s, ~%s" % (runs, "" if runs == 1 else "s", clock)

    def _show_standing(self, st):
        if not st:
            return
        self.standing = st
        self._check_band_change(st)
        bits = ["%st delivered" % f"{st['contribution']:,}",
                "top %s%%" % st["band"]]

        gap, approx, target = None, False, None
        if st["next_known"] and st["to_next"] is not None:
            gap = st["to_next"]
            target = st["contribution"] + gap
        elif st.get("est_next"):
            target = st["est_next"]
            gap = max(0, target - st["contribution"])
            approx = True

        detail = []
        if gap is not None:
            # Percent of the way from where this band started to where the
            # next one does - "how close am I to promotion", not "how much of
            # the total have I done".
            entered = st["contribution"] - (st["hold_margin"] or 0)
            span = max(1, target - entered)
            pct = max(0.0, min(100.0, 100.0 * (st["contribution"] - entered) / span))
            bits.append("%s%.0f%% to top %s%%" % ("~" if approx else "",
                                                  pct, st["next_band"]))
            detail.append(
                "%s%st still needed to reach top %s%%\n%s"
                % ("about " if approx else "", f"{gap:,}", st["next_band"],
                   self._effort(gap)))
            top = (self.data or {}).get("mixed") or []
            plan = top[0]["trip_minutes"] if top else None
            if plan:
                extra = ""
                if self.real_cycle and self.real_cycle > plan * 1.15:
                    extra = ("\nYou have actually been averaging %.0f min a run."
                             % self.real_cycle)
                detail.append(
                    "Based on %.0f min a run: the route plus a two-minute\n"
                    "turnaround at each end.%s" % (plan, extra))
            detail.append("You are %.0f%% of the way from top %s%% to top %s%%."
                          % (pct, st["band"], st["next_band"]))
            if approx:
                detail.append("The threshold is extrapolated from the bands you\n"
                              "have already crossed; real ones drift up as\n"
                              "other commanders deliver.")
        if st["hold_margin"] is not None:
            # A cushion is worth knowing in runs too: one bad day of other
            # commanders delivering can erase it.
            try:
                hold = max(1, int(float(self.v_hold.get().strip())))
            except (ValueError, AttributeError):
                hold = 1
            runs = st["hold_margin"] // hold
            bits.append("%st clear%s"
                        % (f"{st['hold_margin']:,}",
                           " (%d run%s)" % (runs, "" if runs == 1 else "s")
                           if runs else ""))
        if st["hours_left"] and st["hours_left"] > 0:
            d, h = divmod(int(st["hours_left"]), 24)
            bits.append("%dd %dh left" % (d, h))
        self.standing_lbl.configure(text="   ".join(bits))
        if st.get("hours_left"):
            detail.append("Goal ends in %s." % _dhm(st["hours_left"]))
        self.standing_tip.text = "\n\n".join(detail)

    def _measure_cycle(self):
        """How long a run really takes you, as opposed to how long the
        travel model says it should."""
        if journal is None or not self.watcher:
            return
        self.real_cycle = journal.real_cycle_minutes(
            self.watcher.dest_docks, self.dest.get("station"))

    def _adopt_ship(self):
        """Take hold size, jump ranges and pad class from the ship you fly.

        These are facts about the ship, not preferences. While a journal is
        readable it is the source of truth and the three boxes are locked to
        it; they only open up when no ship can be seen, where a commander's
        own estimate is all there is. The defaults behind them are a small
        starter hauler's, deliberately: too small is visibly wrong, whereas a
        plausible big-ship number would be believed.

        Laden range is the one the game never states. It is derived from the
        mass ratio (FSD range is inversely proportional to total mass) and
        floored by the longest jump actually made with cargo aboard.
        """
        w = self.watcher
        if not w or not w.ship:
            self._lock_ship_boxes(None)
            return
        sig = (w.ship, w.ship_id, w.cargo_capacity, w.max_jump_range,
               w.unladen_mass, w.fuel_capacity, w.best_laden_jump)
        if sig == getattr(self, "_ship_sig", None):
            return                      # same ship, same numbers, nothing to say
        self._ship_sig = sig

        if self.ship_id is not None and (w.ship, w.ship_id) != self.ship_id:
            # ShipyardSwap names the new hull a moment before its Loadout
            # states the hold and the range, so the swap stays pending until
            # the figures that go with it arrive.
            self._pending_swap = True
        self.ship_id = (w.ship, w.ship_id)
        # The hull decides the pad. An override only still has a job for a
        # hull this build has never heard of, where pad_for_ship guesses L.
        self.pad = (self.cfg.get("pad_override") or "L"
                    if w.ship not in SHIP_PADS else pad_for_ship(w.ship))
        self.ship_label = w.ship_name or w.ship
        laden = None
        if journal is not None:
            laden = journal.laden_jump_range(
                w.max_jump_range, w.unladen_mass, w.fuel_capacity,
                w.cargo_capacity, w.best_laden_jump)
        var = {"hold": self.v_hold, "jump_empty": self.v_je,
               "jump_laden": self.v_jl}
        for key, value in ship_params(w.ship, w.cargo_capacity,
                                      w.max_jump_range, laden).items():
            var[key].set(value)
        self._lock_ship_boxes(w, laden)

        summary = ("%s  -  %st hold, %s pad, %s ly laden"
                   % (self.ship_label, w.cargo_capacity or "?", self.pad,
                      "%.1f" % laden if laden else "?"))
        if self._pending_swap and not (w.cargo_capacity and w.max_jump_range):
            self.set_status("Switched to %s - waiting for its loadout"
                            % self.ship_label, WARN)
        elif self._pending_swap:
            self._pending_swap = False
            # Pad class decides which stations are eligible at all, so the
            # results on screen are about a ship no longer being flown.
            self.set_status("Now flying " + summary, OR)
            if self.data and not self.busy:
                self.search()
        else:
            self.set_status(summary)

    def _lock_ship_boxes(self, w, laden=None):
        """Ship boxes are readable but not typeable while a ship is detected.

        Silently overwriting what someone typed would be worse than refusing
        it: the box would look accepted and plan something else.
        """
        detail = {}
        if w:
            detail = {
                "hold": "%st, from the ship's Loadout." % (w.cargo_capacity or "?"),
                "jump_empty": "%s ly, the MaxJumpRange in the ship's Loadout."
                              % ("%.1f" % w.max_jump_range
                                 if w.max_jump_range else "?"),
                "jump_laden": "%s ly, from the mass ratio%s."
                              % ("%.1f" % laden if laden else "?",
                                 ", floored by your longest jump with cargo "
                                 "(%.1f ly)" % w.best_laden_jump
                                 if w.best_laden_jump else ""),
            }
        for key, (entry, cap, label, tip) in self.boxes.items():
            if w:
                entry.state(["readonly"])
                cap.configure(text=label + " *")
                tip.text = ("%s\n\nRead from your journal (%s), which is the "
                            "source of truth while the game logs are "
                            "available." % (detail.get(key, ""),
                                            w.ship_name or w.ship))
            else:
                entry.state(["!readonly"])
                cap.configure(text=label)
                tip.text = ("No ship in the journal, so this one is yours to "
                            "set. It is remembered between sessions.")

    def _show_cal(self):
        if self.cal:
            self.cal_lbl.configure(text="TIMINGS  " + self.cal.summary())

    def _poll_journal(self, token=None):
        if self.closing:
            return
        if token is not None and token != self._poll_token:
            return                      # superseded by a newer poll chain
        if self.watcher:
            try:
                self.watcher.poll()
                self._show_cal()
            except Exception:
                pass
            self.root.after(3000, self._poll_journal, self._poll_token)

    def _on_join(self, e):
        """CommunityGoalJoin means they just registered - stop nagging."""
        self._set_banner("")
        self.cfg.pop("dest_manual", None)
        self._adopt_destination()
        self.refresh_standing()

    SHIP_EVENTS = ("Loadout", "ShipyardSwap", "ShipyardNew", "LoadGame",
                   "FSDJump")

    def _on_journal_event(self, e):
        ev = e.get("event")
        if ev in ("CommunityGoalJoin", "CommunityGoalDiscard"):
            self._on_join(e)
            return
        if ev in self.SHIP_EVENTS:
            # Swapping ship or refitting changes the hold, the jump ranges and
            # the pad; a laden jump is fresh evidence of the real laden range.
            # None of it should need a restart to be believed.
            self._adopt_ship()
            return
        if ev != "Market" or not self.v_eddn.get():
            return                      # the game just rewrote Market.json
        if not (eddn and self.sender and self.watcher):
            return
        path = os.path.join(self.watcher.dir, "Market.json")
        args = (path, self.watcher.commander, self.watcher.horizons,
                self.watcher.odyssey, self.watcher.gameversion,
                self.watcher.gamebuild)

        def worker():
            ok, msg = self.sender.maybe_send(*args)
            if not self.closing:
                self.q.put(("eddn", (ok, msg)))

        # The upload can block for 20s; never run it on the UI thread.
        self._spawn(worker)

    def registered(self):
        """Has this commander actually signed up to the goal we are using?"""
        return not str(self.dest.get("source", "")).startswith("live CG")

    def _on_docked(self, station, system):
        """Docking at the CG station means a run just ended - refresh."""
        self._save_cal()
        at_destination = (station == self.dest.get("station")
                          and (not system or system == self.dest.get("system")))

        if at_destination and not self.registered():
            # They are standing at the board right now - the one moment the
            # reminder is worth anything. Worth overriding an earlier dismissal.
            self.banner_dismissed = False
            self._set_banner(
                "You're docked at %s - don't forget to register for the "
                "community goal while you're here, or your deliveries won't "
                "count." % station)
            self._notify(
                "You're at %s - register for the CG" % station,
                "The goal board is here. Sign up now so your deliveries count.",
                "high")

        if (at_destination and not self.busy):
            self.status.configure(
                text="Docked at %s - refreshing for the next run..." % station,
                foreground=OR)
            self._measure_cycle()
            self.search()
            self.refresh_standing()

    def _save_cal(self):
        if getattr(self, "cal", None):
            self.cfg["calibration"] = self.cal.to_dict()
            if self.watcher and self.watcher.dir:
                self.cfg["journal_dir"] = self.watcher.dir
            save_config(self.cfg)

    # -- behaviour -------------------------------------------------------
    def _params(self):
        def num(var, default, cast=float):
            try:
                return cast(var.get().strip())
            except ValueError:
                return default
        return {
            # An unreadable box falls back to what it started as, not to some
            # other ship's numbers.
            "hold": max(1, num(self.v_hold, HOLD_DEFAULT, int)),
            "range": max(1.0, num(self.v_range, float(RANGE_DEFAULT))),
            "jump_empty": max(1.0, num(self.v_je, JUMP_EMPTY_DEFAULT)),
            "jump_laden": max(1.0, num(self.v_jl, JUMP_LADEN_DEFAULT)),
            "min_supply": max(0, num(self.v_ms, MIN_SUPPLY_DEFAULT, int)),
            "carriers": bool(self.v_fc.get()),
            "pad": self.pad,
            "dest": self.dest,
            "max_age_days": max(0, num(self.v_age, MAX_AGE_DEFAULT, int)),
            "verify_edsm": bool(self.cfg.get("verify_edsm", True)),
            "verify_top": int(self.cfg.get("verify_top", VERIFY_TOP_DEFAULT)),
        }

    PARAM_KEYS = (("hold", "v_hold"), ("range", "v_range"),
                  ("jump_empty", "v_je"), ("jump_laden", "v_jl"),
                  ("min_supply", "v_ms"), ("max_age_days", "v_age"))

    def _save_params(self):
        """Search boxes were reset to defaults on every launch."""
        self.cfg["params"] = {k: getattr(self, v).get()
                              for k, v in self.PARAM_KEYS}
        save_config(self.cfg)

    def _load_params(self):
        """Restore the toolbar from last time.

        The ship boxes are restored too, but only as a stand-in until the
        journal is read - _adopt_ship overwrites them a moment later. They
        matter when there is no journal at all, where last session's numbers
        beat a starter hauler's.
        """
        saved = self.cfg.get("params") or {}
        for k, v in self.PARAM_KEYS:
            if saved.get(k):
                getattr(self, v).set(saved[k])

    def search(self):
        if self.busy:
            return
        if not self.dest.get("station") or not self.dest.get("commodities"):
            self.set_status(
                "No destination - no trade CG is running, so set a station "
                "in SETTINGS (it works for ordinary hauling too)", WARN)
            return
        self._save_params()
        self.busy = True
        self.go.state(["disabled"])
        self._tick_age()
        self.pbar.configure(maximum=max(1, len(self.dest["commodities"])))
        self.pbar["value"] = 0
        self.status.configure(text="Starting...", foreground=DIM)
        self._spawn(lambda: self._work(self._params()))

    def _work(self, params):
        try:
            rows, cg, cg_ls, hidden_stale = build_rows(
                params, lambda d, t, n: self.q.put(("prog", (d, t, n))),
                cal=self.cal)
            rows.sort(key=lambda r: -r["cr_per_min"])
            if self.closing:
                return
            self.q.put(("done", {
                "rows": rows, "mixed": build_mixed(rows, params["hold"]),
                "cg": cg, "cg_ls": cg_ls, "params": params,
                "hidden_stale": hidden_stale, "fetched_at": time.time(),
                "dest": params.get("dest")}))
        except Exception as e:
            self.q.put(("err", "%s: %s" % (type(e).__name__, e)))

    def _drain(self):
        if self.closing:
            return
        try:
            self._drain_once()
        finally:
            # Must always reschedule: an error inside _finish used to leave the
            # UI frozen with SEARCH disabled for the rest of the session.
            self.root.after(80, self._drain)

    def _drain_once(self):
        try:
            while True:
                kind, payload = self.q.get_nowait()
                if kind == "prog":
                    d, t, n = payload
                    self.pbar["value"] = d
                    self.status.configure(
                        text="Fetching %d/%d commodities  -  %s" % (d, t, n),
                        foreground=DIM)
                elif kind == "done":
                    self._finish(payload)
                elif kind == "commodities":
                    found, redraw, allnames = payload
                    allnames[:] = found
                    redraw()
                elif kind == "dest":
                    self._apply_destination(payload)
                elif kind == "standing":
                    self._show_standing(payload)
                elif kind == "eddn":
                    ok, msg = payload
                    if msg != "already sent":
                        self.set_status("EDDN: %s" % msg, None if ok else BAD)
                        self.cfg["eddn_seen"] = self.sender.to_list()
                        save_config(self.cfg)
                elif kind == "err":
                    self.busy = False
                    self.go.state(["!disabled"])
                    self.status.configure(text=payload, foreground=BAD)
        except queue.Empty:
            pass
        except Exception as e:
            self.busy = False
            try:
                self.go.state(["!disabled"])
                self.set_status("display error: %s" % e, BAD)
            except Exception:
                pass

    def _finish(self, d, from_cache=False):
        self.data = d
        self.last_fetch = d.get("fetched_at")
        self.busy = False
        self.go.state(["!disabled"])
        self.pbar["value"] = self.pbar["maximum"]
        self.cg_lbl.configure(text="%s  -  %s  -  %s Ls from arrival"
                              % (self.dest["station"], self.dest["system"],
                                 f"{d['cg_ls']:,.0f}"))
        order = sorted(d["cg"], key=lambda k: -d["cg"][k]["sell"])
        self.prices.configure(
            text="CG PAYS   " + "    ".join(
                "%s %s" % (k, f"{d['cg'][k]['sell']:,}") for k in order))
        hidden = d.get("hidden_stale") or 0
        extra = ("   %d hidden as stale - raise MAX AGE to see them"
                 % hidden) if hidden else ""
        self.status.configure(
            text="%s sources across %d commodities%s"
                 % (f"{len(d['rows']):,}", len(d["cg"]),
                    "  (cached, %s old)" % age_phrase(d.get("fetched_at"))
                    if from_cache else "") + extra, foreground=DIM)
        self._fill_mixed()
        self._fill_single()
        if not from_cache:
            self._check_new_best(d.get("mixed") or [])
        if not from_cache:
            save_cache(d)
        self._tick_age()

    def _fill_mixed(self):
        t = self.t_mixed
        t.delete(*t.get_children())
        self._forget_rows(t)
        for i, p in enumerate(self.data["mixed"][:40]):
            carrier = "  [CARRIER]" if p["carrier"] else ""
            short = ("  -  %dt short" % p["short"]) if p["short"] else ""
            parent = t.insert(
                "", "end", open=(i < 5),
                values=("%d. %s%s" % (i + 1, p["station"], carrier),
                        "%s  -  %.1f ly  -  %s Ls  -  data %s%s"
                        % (p["system"], p["ly"], f"{p['ls']:,}",
                           age_text(p["updated"]), short),
                        "%st" % f"{p['tonnes']:,}", "",
                        f"{p['total']:,}", f"{p['cr_per_min']:,}"),
                tags=("head",) if i else ("head", "top"))
            self._remember(t, parent, p["system"])
            for m in p["mix"]:
                child = t.insert(parent, "end", values=(
                    "      %s" % m["commodity"],
                    "buy %s" % f"{m['buy']:,}",
                    "%st" % f"{m['tonnes']:,}",
                    "+%s" % f"{m['profit_per_t']:,}",
                    f"{m['value']:,}", ""), tags=("child",))
                self._remember(t, child, p["system"])

    def _sort_by(self, col):
        if self.sort_key == col:
            self.sort_desc = not self.sort_desc
        else:
            self.sort_key, self.sort_desc = col, True
        self._fill_single()

    def _fill_single(self):
        t = self.t_single
        t.delete(*t.get_children())
        self._forget_rows(t)
        if not self.data:
            return
        k, desc = self.sort_key, self.sort_desc
        rows = sorted(self.data["rows"], key=lambda r: r[k], reverse=desc)[:400]
        for k2, lbl, _w, _a in self.SINGLE_COLS:
            arrow = ("  v" if desc else "  ^") if k2 == k else ""
            t.heading(k2, text=lbl + arrow)
        for i, r in enumerate(rows):
            stn = r["station"] + ("  [FC]" if r["carrier"] else "")
            tags = [age_tag(r["updated"])]
            if i % 2:
                tags.append("odd")
            iid = t.insert("", "end", values=(
                r["commodity"], stn, r["system"], "%.1f" % r["ly"],
                f"{r['ls']:,}", f"{r['supply']:,}", r["loads_available"],
                f"{r['buy']:,}", f"{r['profit_per_t']:,}",
                "%dm" % round(r["trip_minutes"]), f"{r['cr_per_min']:,}",
                r["t_per_min"], age_text(r["updated"]),
                "EDSM" if r.get("edsm") else "spansh"), tags=tags)
            self._remember(t, iid, r["system"])


