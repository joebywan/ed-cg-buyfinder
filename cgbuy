def post_json(url, payload, timeout=60):
    req = urllib.request.Request(
        url, data=json.dumps(payload).encode(),
        headers={"User-Agent": AGENT, "Content-Type": "application/json"},
        method="POST")
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def get_json(url, timeout=45):
    req = urllib.request.Request(url, headers={"User-Agent": AGENT})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def fetch_cg_prices(dest):
    """Sell prices at the destination for the goods we care about.

    Any community-goal multiplier is already baked into what the station
    reports, so it is never applied here.
    """
    wanted = set(dest["commodities"])
    url = EDSM_MARKET.format(sys=urllib.parse.quote(dest["system"]),
                             stn=urllib.parse.quote(dest["station"]))
    data = get_json(url)
    return {c["name"]: {"sell": c["sellPrice"], "demand": c["demand"]}
            for c in data.get("commodities", []) if c["name"] in wanted}


def fetch_cg_arrival_ls(dest):
    try:
        d = get_json(EDSM_STATIONS.format(sys=urllib.parse.quote(dest["system"])))
        for s in d.get("stations", []):
            if s["name"] == dest["station"]:
                return s.get("distanceToArrival", 0) or 0
    except Exception:
        pass
    return 0


def fetch_sources(commodity, max_ly, min_supply, reference_system,
                  page_size=500, max_pages=10):
    """Every market within max_ly that stocks `commodity`.

    Spansh caps results per request, so page through until we run past the
    radius. A single fixed page silently drops most candidates.
    """
    out = []
    for page in range(max_pages):
        payload = {
            "filters": {
                "distance": {"comparison": "<=>", "value": [0, max_ly]},
                "market": [{
                    "name": commodity,
                    "supply": {"comparison": "<=>",
                               "value": [min_supply, 100000000]},
                }],
            },
            "sort": [{"distance": {"direction": "asc"}}],
            "size": page_size, "page": page,
            "reference_system": reference_system,
        }
        try:
            res = post_json(SPANSH_SEARCH, payload).get("results", [])
        except Exception as e:
            # A dropped connection must not abort every other commodity.
            print("  ! %s page %d: %s" % (commodity, page, e), file=sys.stderr)
            break
        out.extend(res)
        if len(res) < page_size or res[-1].get("distance", 0) > max_ly:
            break
    return out


def sc_minutes(ls):
    """Rough supercruise time from the arrival star, in minutes.

    Calibration divides observed times by this curve to get sc_scale, then
    trip_minutes multiplies it back on. Two copies of the formula would
    silently miscalibrate if they ever drifted, so journal.py owns it and
    this is only a fallback for running without that module.
    """
    if journal is not None:
        return journal.est_sc_minutes(ls)
    return 0.25 * max(ls, 1) ** 0.3


