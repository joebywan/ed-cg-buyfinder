    def _header(self):
        f = ttk.Frame(self.root, padding=(16, 12, 16, 8))
        f.grid(row=0, column=0, sticky="ew")
        ttk.Label(f, text="CG BUY FINDER", style="Or.TLabel").pack(side="left")
