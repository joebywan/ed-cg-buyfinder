def _apply_icon(root):
    """Best-effort window icon. A missing icon must never stop the app."""
    try:
        import base64 as _b64
        img = tk.PhotoImage(data=_b64.b64decode(ICON_PNG_B64))
        root.iconphoto(True, img)
        root._icon_ref = img          # Tk does not keep its own reference
    except Exception:
        pass


VERSION = "1.3"

USAGE = """cgbuy - where to buy for a community goal, ranked by credits/minute

  cgbuy                  open the window and search
  cgbuy --no-autosearch  open without searching
  cgbuy --version        print the version and exit
  cgbuy --help           this text

Destination, ship and data settings live in the window (SETTINGS).
Config: %s
Cache:  %s
""" % (CONFIG_PATH, CACHE_PATH)


def main():
    # Handled before any Tk work so the binary can be smoke-tested headless.
    if "--help" in sys.argv or "-h" in sys.argv:
        print(USAGE)
        return
    if "--version" in sys.argv:
        print("cgbuy %s" % VERSION)
        return
    autosearch = "--no-autosearch" not in sys.argv
    try:
        root = tk.Tk()
    except tk.TclError as e:
        sys.exit("Cannot open a display (%s). This is a desktop app - run it "
                 "on the machine's desktop session." % e)
    App(root, autosearch=autosearch)
    root.mainloop()


if __name__ == "__main__":
    main()
