    def _apply_col_widths(self):
        """Column widths are in pixels, so they have to track the font size
        or the numbers get truncated at larger sizes."""
        scale = self.fs / float(FONT_DEFAULT)
        for tree, cols in ((self.t_mixed, self.MIXED_COLS),
                           (self.t_single, self.SINGLE_COLS)):
            for key, _lbl, w, _anc in cols:
                tree.column(key, width=int(w * scale),
                            minwidth=int(w * scale), stretch=False)
        self.t_mixed.column("#0", width=int(26 * scale), stretch=False)

    def _fit_window(self):
        scale = self.fs / float(FONT_DEFAULT)
        w = min(int(1480 * scale), self.root.winfo_screenwidth() - 60)
        h = min(int(860 * scale), self.root.winfo_screenheight() - 80)
        self.root.geometry("%dx%d" % (w, h))


    def _start_with_cache(self):
        """Show recent results, or just go and get fresh ones.

        Asking "this is 3 hours old, update?" only to be told yes every time
        is a dialog that exists to be dismissed. Inside the freshness window
        the cache is good enough to show immediately; outside it, refetch
        without asking - the search is non-destructive and takes ~25s.
        """
        cached = load_cache()
        if cached:
            cd = cached.get("dest") or {}
            # Results from a different destination would render under this
            # one's header, which is worse than no cache at all.
            if (cd.get("station"), cd.get("system")) != (self.dest["station"],
                                                         self.dest["system"]):
                cached = None

        if not cached:
            self.search()
            return

        mins = cache_age_minutes(cached.get("fetched_at"))
        fresh = int(self.cfg.get("cache_fresh_minutes", CACHE_FRESH_MINUTES))
        if mins is None or mins >= fresh:
            # Still paint the old numbers first so the window is never blank
            # while the search runs.
            self._finish(cached, from_cache=True)
            self.search()
            return
        self._finish(cached, from_cache=True)

