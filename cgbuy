# Monospace families in preference order. DejaVu is the Linux default,
# Consolas ships with Windows, Menlo with macOS; the last is always present.
FONT_CANDIDATES = ("DejaVu Sans Mono", "Consolas", "Menlo", "Liberation Mono",
                   "Courier New", "TkFixedFont")


def pick_font_family():
    """First installed family from the preference list."""
    try:
        from tkinter import font as tkfont
        have = {f.lower() for f in tkfont.families()}
    except Exception:
        return "Courier"
    for name in FONT_CANDIDATES:
        if name.lower() in have:
            return name
    return "Courier"


