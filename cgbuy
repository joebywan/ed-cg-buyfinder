    def _tree(self, parent, columns, show):
        wrap = ttk.Frame(parent)
        wrap.pack(fill="both", expand=True)
        
        t = ttk.Treeview(wrap, columns=[c[0] for c in columns], show=show)
        vs = ttk.Scrollbar(wrap, orient="vertical", command=t.yview)
        hs = ttk.Scrollbar(wrap, orient="horizontal", command=t.xview)
        t.configure(yscrollcommand=vs.set, xscrollcommand=hs.set)
        t.grid(row=0, column=0, sticky="nsew")
        vs.grid(row=0, column=1, sticky="ns")
        hs.grid(row=1, column=0, sticky="ew")
        wrap.rowconfigure(0, weight=1)
        wrap.columnconfigure(0, weight=1)
        t.tag_configure("odd", background=ROW_ALT)
        t.tag_configure("age_ok", foreground=GOOD)
        t.tag_configure("age_mid", foreground=WARN)
        t.tag_configure("age_old", foreground=BAD)
        t.tag_configure("top", background="#241a10")
        t.tag_configure("head", foreground=OR, font=self._fonts()["bold"])
        t.tag_configure("child", foreground=TXT)
        t.tag_configure("muted", foreground=DIM)
        t.bind("<ButtonRelease-1>", self._copy_clicked)
        return t

    def _forget_rows(self, tree):
        """Drop this tree's entries; ids are reused after a refill."""
        name = str(tree)
        for k in [k for k in self.copy_map if k[0] == name]:
            del self.copy_map[k]

    def _remember(self, tree, item, system):
        self.copy_map[(str(tree), item)] = system

    def _copy_clicked(self, event):
        """Click a row to put its system name on the clipboard."""
        tree = event.widget
        item = tree.identify_row(event.y)
        if not item:
            return
        # Ignore clicks on the expand/collapse arrow - that is a disclosure,
        # not a selection.
        if tree.identify_element(event.x, event.y) == "Treeitem.indicator":
            return
        system = self.copy_map.get((str(tree), item))
        if not system:
            return
        try:
            self.root.clipboard_clear()
            self.root.clipboard_append(system)
            self.root.update_idletasks()
        except tk.TclError:
            self.set_status("could not reach the clipboard", BAD)
            return
        self.set_status("copied  %s" % system, OR)

