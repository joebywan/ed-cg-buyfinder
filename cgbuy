        def derive_from_market():
            """Read the destination's own market and pick the premium goods."""
            jd = self.watcher.dir if self.watcher else None
            if not jd:
                dest_note.configure(text="journal folder unknown", foreground=BAD)
                return
            try:
                with open(os.path.join(jd, "Market.json"),
                          encoding="utf-8", errors="replace") as fh:
                    mk = json.load(fh)
            except (OSError, ValueError) as e:
                dest_note.configure(text="cannot read Market.json: %s" % e,
                                    foreground=BAD)
                return
            if mk.get("StationName") != v_stn.get().strip():
                dest_note.configure(
                    text="Market.json is %s - dock at %s and open its market first"
                         % (mk.get("StationName"), v_stn.get().strip()),
                    foreground=WARN)
                return
            found = derive_commodities(mk.get("Items"))
            if not found:
                dest_note.configure(text="no premium-priced goods found here",
                                    foreground=WARN)
