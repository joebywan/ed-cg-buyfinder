def save_cache(payload):
    """Keep the last search so the app opens with data instead of a blank grid."""
    try:
        os.makedirs(os.path.dirname(CACHE_PATH), exist_ok=True)
        tmp = CACHE_PATH + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(payload, fh)
        os.replace(tmp, CACHE_PATH)     # atomic: never leave a torn file
    except OSError:
        pass


def load_cache():
    try:
        with open(CACHE_PATH) as fh:
            d = json.load(fh)
        if isinstance(d, dict) and d.get("rows"):
            return d
    except (OSError, ValueError):
        pass
    return None


def age_phrase(stamp):
    """'3 minutes', '2 hours' - for the refresh prompt."""
    try:
        secs = max(0, int(time.time() - float(stamp)))
    except (TypeError, ValueError):
        return "an unknown time"
    if secs < 90:
        return "%d seconds" % secs
    if secs < 5400:
        m = round(secs / 60.0)
        return "%d minute%s" % (m, "" if m == 1 else "s")
    if secs < 172800:
        h = round(secs / 3600.0)
        return "%d hour%s" % (h, "" if h == 1 else "s")
    d = round(secs / 86400.0)
    return "%d day%s" % (d, "" if d == 1 else "s")


def write_state(plans, keep_index=None, advance=False):
    """Publish the ranked plan list for the deck button.

    keep_index pins the index; advance moves to the next target.
    """
    slim = [{"station": p["station"], "system": p["system"], "ly": p["ly"],
             "ls": p["ls"], "total": p["total"], "cr_per_min": p["cr_per_min"],
             "updated": p["updated"],
             "mix": [{"commodity": m["commodity"], "tonnes": m["tonnes"],
                      "buy": m["buy"]} for m in p["mix"]]}
            for p in plans[:8]]
    prev = {}
    try:
        with open(STATE_PATH) as fh:
            prev = json.load(fh)
    except Exception:
        pass
    idx = keep_index if keep_index is not None else prev.get("index", 0)
    if advance and slim:
        idx = (idx + 1) % len(slim)
    try:
        os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
        tmp = STATE_PATH + ".tmp"
        with open(tmp, "w") as fh:
            json.dump({"plans": slim, "index": min(idx, max(0, len(slim) - 1))},
                      fh, indent=2)
        os.replace(tmp, STATE_PATH)     # readers never see a partial file
    except OSError:
        pass


def load_config():
    try:
        with open(CONFIG_PATH) as fh:
            return json.load(fh)
    except Exception:
        return {}


def save_config(cfg):
    try:
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, "w") as fh:
            json.dump(cfg, fh, indent=2)
    except OSError:
        pass          # a UI preference is never worth crashing over


def days_old(datestr):
    """Whole days since an ISO date, or None if we have no date."""
    if not datestr:
        return None
    try:
        y, m, d = (int(x) for x in datestr.split("-"))
    except ValueError:
        return None
    import datetime
    return (datetime.date.today() - datetime.date(y, m, d)).days


def age_text(datestr):
    n = days_old(datestr)
    if n is None:
        return "?"
    return "today" if n < 1 else "%dd ago" % n


def age_tag(datestr):
    n = days_old(datestr)
    if n is None:
        return "age_old"
    return "age_ok" if n <= 21 else ("age_mid" if n <= 120 else "age_old")


class App:
    SINGLE_COLS = [
        ("commodity", "COMMODITY", 96, "w"), ("station", "STATION", 210, "w"),
        ("system", "SYSTEM", 200, "w"), ("ly", "LY", 56, "e"),
        ("ls", "LS", 78, "e"), ("supply", "SUPPLY", 84, "e"),
        ("loads_available", "LOADS", 60, "e"), ("buy", "BUY", 78, "e"),
        ("profit_per_t", "PROFIT/T", 86, "e"), ("trip_minutes", "TRIP", 56, "e"),
        ("cr_per_min", "CR/MIN", 92, "e"), ("t_per_min", "T/MIN", 62, "e"),
        ("updated", "DATA", 78, "e"), ("src", "SRC", 52, "e"),
    ]

    def __init__(self, root, autosearch=True):
        self.root = root
        self.cfg = load_config()
        self.entries = []
        self.copy_map = {}          # (widget name, item id) -> system name
        # 9pt is unreadable on a 5K panel, so scale the default to the display.
        sw = root.winfo_screenwidth()
        auto = FONT_DEFAULT if sw < 2560 else (14 if sw < 3840 else 17)
        self.fs = min(FONT_MAX, max(FONT_MIN,
                      int(self.cfg.get("font_size", auto))))
        self.data = None
        self.q = queue.Queue()
        self.sort_key = "cr_per_min"
        self.sort_desc = True
        self.busy = False

        root.title("CG Buy Finder - Ega")
        root.configure(bg=BG)
        root.geometry("1480x860")
        root.minsize(1000, 600)

        self._style()
        self._header()
        self._controls()
        self._tabs()
        self._statusbar()
        self._apply_col_widths()
        self._fit_window()
        self._init_journal()

        root.columnconfigure(0, weight=1)
        root.rowconfigure(3, weight=1)
        root.after(80, self._drain)
        if autosearch:
            root.after(200, self._start_with_cache)
        root.bind("<Return>", lambda e: self.search())
        root.bind("<Control-q>", lambda e: self._quit())
        root.protocol("WM_DELETE_WINDOW", self._quit)
        root.bind("<Control-plus>", lambda e: self.bump_font(1))
        root.bind("<Control-equal>", lambda e: self.bump_font(1))
        root.bind("<Control-minus>", lambda e: self.bump_font(-1))

    # -- chrome ----------------------------------------------------------
    def _fonts(self):
        """All fonts derive from self.fs so one setting rescales everything."""
        n = self.fs
        return {
            "mono": (FONT_FAMILY, n),
            "bold": (FONT_FAMILY, n, "bold"),
            "cap": (FONT_FAMILY, max(FONT_MIN - 1, n - 1)),
            "head": (FONT_FAMILY, max(FONT_MIN - 1, n - 1), "bold"),
            "title": (FONT_FAMILY, n + 4, "bold"),
        }

    def _style(self):
        f = self._fonts()
        MONO, MONO_B = f["mono"], f["bold"]
        TITLE = f["title"]
        s = ttk.Style()
        try:
            s.theme_use("clam")
        except tk.TclError:
            pass
        s.configure(".", background=BG, foreground=TXT, font=MONO)
        s.configure("TFrame", background=BG)
        s.configure("Panel.TFrame", background=PANEL)
        s.configure("TLabel", background=BG, foreground=TXT, font=MONO)
        s.configure("Dim.TLabel", background=BG, foreground=DIM, font=MONO)
        s.configure("Cap.TLabel", background=PANEL, foreground=DIM, font=f["cap"])
        s.configure("PanelDim.TLabel", background=PANEL, foreground=DIM, font=MONO)
        s.configure("PanelTxt.TLabel", background=PANEL, foreground=TXT, font=MONO)
        s.configure("Or.TLabel", background=BG, foreground=OR, font=TITLE)
        s.configure("Sub.TLabel", background=BG, foreground=DIM, font=MONO)

        s.configure("TEntry", fieldbackground="#0a0908", foreground=TXT,
                    insertcolor=OR, bordercolor=LINE, lightcolor=LINE,
                    darkcolor=LINE, borderwidth=1)
