def save_cache(payload):
    """Keep the last search so the app opens with data instead of a blank grid."""
    try:
        os.makedirs(os.path.dirname(CACHE_PATH), exist_ok=True)
        tmp = CACHE_PATH + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(payload, fh)
        os.replace(tmp, CACHE_PATH)     # atomic: never leave a torn file
    except OSError:
        pass


def load_cache():
    try:
        with open(CACHE_PATH) as fh:
            d = json.load(fh)
        if isinstance(d, dict) and d.get("rows"):
            return d
    except (OSError, ValueError):
        pass
    return None


def cache_age_minutes(stamp):
    """Minutes since the cache was written, or None if unknown."""
    try:
        return max(0.0, (time.time() - float(stamp)) / 60.0)
    except (TypeError, ValueError):
        return None


def age_phrase(stamp):
    """'3 minutes', '2 hours' - for the refresh prompt."""
    try:
        secs = max(0, int(time.time() - float(stamp)))
    except (TypeError, ValueError):
        return "an unknown time"
    if secs < 90:
        return "%d seconds" % secs
    if secs < 5400:
        m = round(secs / 60.0)
        return "%d minute%s" % (m, "" if m == 1 else "s")
    if secs < 172800:
        h = round(secs / 3600.0)
        return "%d hour%s" % (h, "" if h == 1 else "s")
    d = round(secs / 86400.0)
    return "%d day%s" % (d, "" if d == 1 else "s")


def write_state(plans, keep_index=None, advance=False):
    """Publish the ranked plan list for the deck button.

    keep_index pins the index; advance moves to the next target.
    """
    slim = [{"station": p["station"], "system": p["system"], "ly": p["ly"],
             "ls": p["ls"], "total": p["total"], "cr_per_min": p["cr_per_min"],
             "updated": p["updated"], "tonnes": p["tonnes"], "short": p["short"],
             "trip_minutes": p["trip_minutes"],
             "mix": [{"commodity": m["commodity"], "tonnes": m["tonnes"],
                      "buy": m["buy"]} for m in p["mix"]]}
            for p in plans[:8]]
    prev = {}
    try:
        with open(STATE_PATH) as fh:
            prev = json.load(fh)
    except Exception:
        pass
    idx = keep_index if keep_index is not None else prev.get("index", 0)
    if advance and slim:
        idx = (idx + 1) % len(slim)
    try:
        os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
        tmp = STATE_PATH + ".tmp"
        with open(tmp, "w") as fh:
            json.dump({"plans": slim, "index": min(idx, max(0, len(slim) - 1))},
                      fh, indent=2)
        os.replace(tmp, STATE_PATH)     # readers never see a partial file
    except OSError:
        pass


