    def current_target(self):
        if self.data and self.data.get("mixed"):
            return self.data["mixed"][0]
        return None

    def _spawn(self, fn):
        """Start a background worker that stops touching the UI once closing."""
        t = threading.Thread(target=fn, daemon=True)
        self.workers = [w for w in self.workers if w.is_alive()]
        self.workers.append(t)
        t.start()
        return t

    def _quit(self):
        self._save_cal()
        self.closing = True
        # Give in-flight network calls a moment to notice and return.
        for w in list(self.workers):
            if w.is_alive():
                w.join(timeout=1.5)
        self.root.destroy()

    def bump_font(self, delta):
        new = min(FONT_MAX, max(FONT_MIN, self.fs + delta))
        if new == self.fs:
            return
        self.fs = new
        self.font_lbl.configure(text=str(new))
        self._style()                       # restyle every widget class
        self._apply_col_widths()
        self._fit_window()
        for e in self.entries:              # ttk.Entry font is per-widget
            e.configure(font=self._fonts()["mono"])
        for t in (self.t_mixed, self.t_single):
            t.tag_configure("head", foreground=OR, font=self._fonts()["bold"])
        if self.data:                       # redraw so rows pick up the metrics
            self._fill_mixed()
            self._fill_single()
        self.cfg["font_size"] = new
        save_config(self.cfg)

