    def _apply_col_widths(self):
        """Column widths are in pixels, so they have to track the font size
        or the numbers get truncated at larger sizes."""
        scale = self.fs / float(FONT_DEFAULT)
        for tree, cols in ((self.t_mixed, self.MIXED_COLS),
                           (self.t_single, self.SINGLE_COLS)):
            for key, _lbl, w, _anc in cols:
                tree.column(key, width=int(w * scale),
                            minwidth=int(w * scale), stretch=False)
        self.t_mixed.column("#0", width=int(26 * scale), stretch=False)

    def _fit_window(self):
        scale = self.fs / float(FONT_DEFAULT)
        w = min(int(1480 * scale), self.root.winfo_screenwidth() - 60)
        h = min(int(860 * scale), self.root.winfo_screenheight() - 80)
        self.root.geometry("%dx%d" % (w, h))


