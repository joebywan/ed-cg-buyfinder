def pad_for_ship(ship):
    """Smallest pad this ship needs. Unknown -> L (safe but restrictive)."""
    return SHIP_PADS.get((ship or "").lower(), "L")


def station_fits(st, pad):
    """Can a ship needing `pad` land here?

    Spansh reports per-size pad counts; the old code looked only at
    has_large_pad, which hid every medium and small station from ships that
    could use them.
    """
    # A large pad physically accepts any ship, so the legacy flag has to
    # count toward every size - not just "L", which hid such stations from
    # the smaller ships that could most easily use them.
    large = (st.get("large_pads") or 0) or (1 if st.get("has_large_pad") else 0)
    medium = st.get("medium_pads") or 0
    small = st.get("small_pads") or 0
    if pad == "L":
        return bool(large)
    if pad == "M":
        return bool(large or medium)
    return bool(large or medium or small)

EST_JUMP_MIN = 0.85        # align + charge + jump + scoop
# Fixed, deliberately. Docked -> Undocked cannot distinguish "buying cargo"
# from "went to make tea", and the sanity window that keeps an overnight AFK
# out of the median also discards genuine 40-minute stops. Two minutes is a
# clean turnaround: dock, trade, undock.
EST_DOCK_MIN = 2.0
EST_DEPART_MIN = 1.8       # undocked -> first jump, until measured
EST_SC_SCALE = 1.0         # multiplier on the sc_minutes curve


def trip_minutes(dist_ly, src_ls, cg_ls, jump_empty, jump_laden, cal=None):
    """Round trip: CG -> source empty, source -> CG full.

    An "arrival leg" is supercruise + approach + docking, which is exactly
    what the journal measures as FSDJump -> Docked. Dock time (docked ->
    undocked) is counted separately, so nothing is double-counted.
    """
    jump_min = (cal.jump_minutes if cal and cal.jump_minutes else EST_JUMP_MIN)
    dock_min = EST_DOCK_MIN        # never calibrated; see the constant
    depart_min = (cal.depart_minutes if cal and cal.depart_minutes
                  else EST_DEPART_MIN)
    sc_scale = (cal.sc_scale if cal and cal.sc_scale else EST_SC_SCALE)

    out_j = math.ceil(dist_ly / jump_empty) if dist_ly > 0 else 0
    back_j = math.ceil(dist_ly / jump_laden) if dist_ly > 0 else 0
    jumps = (out_j + back_j) * jump_min
    legs = (sc_minutes(src_ls) + sc_minutes(cg_ls)) * sc_scale
    # Two of each per round trip: leave the destination, arrive at the
    # source, leave the source, arrive back. Departure was previously counted
    # nowhere - jump time is measured jump-to-jump, so the run out from the
    # pad to the first jump fell between the cracks.
    return max(jumps + legs + (dock_min + depart_min) * 2, 0.5)


def build_rows(p, progress=None, cal=None):
    """Fetch everything and score it. `p` is the parameter dict from the UI."""
    dest = p.get("dest") or DEFAULT_DEST
    commodities = list(dest.get("commodities") or ())
    if not dest.get("station") or not dest.get("system") or not commodities:
        # Nothing to search for. Returning empty beats querying a stale
        # default the player has no connection to.
        return [], {}, 0, 0
    cg = fetch_cg_prices(dest)
    if not cg:
        raise RuntimeError("EDSM returned no market for %s - station renamed?"
                           % dest["station"])
    cg_ls = fetch_cg_arrival_ls(dest)
    rows, done, lock = [], 0, threading.Lock()

    def one(name):
        nonlocal done
        info = cg.get(name)
        local = []
        if info and info["sell"] > 0:
            sell = info["sell"]
            for st in fetch_sources(name, p["range"], p["min_supply"],
                                    dest["system"]):
                if not station_fits(st, p.get("pad", "L")):
                    continue
                carrier = "Carrier" in str(st.get("type", ""))
                if carrier and not p["carriers"]:
                    continue
                e = next((c for c in st.get("market", [])
                          if c["commodity"] == name), None)
                if not e or e["supply"] <= 0 or e["buy_price"] <= 0:
                    continue
                dist = st.get("distance", 0.0)
                if dist > p["range"]:
                    continue
                profit = sell - e["buy_price"]
                if profit <= 0:
                    continue
                src_ls = st.get("distance_to_arrival", 0) or 0
                mins = trip_minutes(dist, src_ls, cg_ls,
                                    p["jump_empty"], p["jump_laden"], cal)
                load = min(e["supply"], p["hold"])
                local.append({
                    "commodity": name, "station": st.get("name", "?"),
                    "system": st.get("system_name", "?"), "carrier": carrier,
                    "ly": round(dist, 1), "ls": round(src_ls),
                    "supply": e["supply"], "buy": e["buy_price"], "sell": sell,
                    "profit_per_t": profit, "load": load,
                    "loads_available": round(e["supply"] / p["hold"], 1),
                    "trip_minutes": round(mins, 1),
                    "trip_profit": load * profit,
                    "cr_per_min": round(load * profit / mins),
                    "t_per_min": round(load / mins, 1),
                    "updated": (st.get("market_updated_at") or "")[:10],
                })
        with lock:
            rows.extend(local)
            done += 1
            if progress:
                progress(done, len(commodities), name)

    with ThreadPoolExecutor(max_workers=6) as ex:
        list(ex.map(one, commodities))

    # Spansh is the only way to discover candidates, but its index lags by
    # days. Re-check the shortlist against EDSM, which follows EDDN live.
    if verify is not None and p.get("verify_edsm", True):
        rows.sort(key=lambda r: -r["cr_per_min"])
        if progress:
            progress(len(commodities), len(commodities), "verifying vs EDSM")
        try:
            checked, corrected, limited = verify.refresh(
                rows, top=int(p.get("verify_top", VERIFY_TOP_DEFAULT)))
            for r in rows:
                if r.get("edsm"):
                    rescore(r, p["hold"], cal, cg_ls,
                            p["jump_empty"], p["jump_laden"])
            # A station EDSM says is empty must drop out, not sit at the top
            # on a supply figure that no longer exists.
            rows = [r for r in rows if r["profit_per_t"] > 0 and r["supply"] > 0]
            note = "EDSM: %d checked, %d corrected" % (checked, corrected)
            if limited:
                note += " (rate limited - rest left as Spansh)"
            if progress:
                progress(len(commodities), len(commodities), note)
        except Exception as e:
            print("  ! EDSM verify failed: %s" % e, file=sys.stderr)

    hidden_stale = 0
    max_age = p.get("max_age_days", MAX_AGE_DEFAULT)
    if max_age:
        before = len(rows)
        fresh = []
        for r in rows:
            n = days_old(r.get("updated"))
            # Unknown age is treated as stale: a row with no timestamp is not
            # evidence of freshness.
            if n is not None and n <= max_age:
                fresh.append(r)
        dropped = before - len(fresh)
        if fresh:
            rows = fresh
            hidden_stale = dropped
            if progress:
                progress(len(commodities), len(commodities),
                         "hid %d rows older than %dd" % (dropped, max_age))
        elif progress:
            # Never leave the user with an empty grid because of a filter.
            progress(len(commodities), len(commodities),
                     "all rows older than %dd - showing them anyway" % max_age)

    return rows, cg, cg_ls, hidden_stale


def rescore(r, hold, cal, cg_ls, jump_empty, jump_laden):
    """Recompute the derived figures after EDSM corrects supply or price."""
    r["profit_per_t"] = r["sell"] - r["buy"]
    r["load"] = min(r["supply"], hold)
    r["loads_available"] = round(r["supply"] / hold, 1)
    mins = trip_minutes(r["ly"], r["ls"], cg_ls, jump_empty, jump_laden, cal)
    r["trip_minutes"] = round(mins, 1)
    r["trip_profit"] = r["load"] * r["profit_per_t"]
    r["cr_per_min"] = round(r["load"] * r["profit_per_t"] / mins)
    r["t_per_min"] = round(r["load"] / mins, 1)
    return r


def build_mixed(rows, hold):
    """Rank stations by the best hold they can actually fill.

    A station's most profitable commodity is often supply-capped well below
    your hold. Topping up with that same station's next best costs no extra
    travel, and is typically worth ~20% more per run.
    """
    stations = {}
    for r in rows:
        stations.setdefault((r["station"], r["system"]), []).append(r)

    plans = []
    for (stn, sysn), items in stations.items():
        items.sort(key=lambda r: -r["profit_per_t"])
        remaining, total, mix = hold, 0, []
        for it in items:
            if remaining <= 0:
                break
            take = min(it["supply"], remaining)
            if take <= 0:
                continue
            mix.append({"commodity": it["commodity"], "tonnes": take,
                        "profit_per_t": it["profit_per_t"],
                        "buy": it["buy"], "value": take * it["profit_per_t"]})
            total += take * it["profit_per_t"]
            remaining -= take
        if not mix:
            continue
        mins = items[0]["trip_minutes"]
        plans.append({
            "station": stn, "system": sysn, "ly": items[0]["ly"],
            "ls": items[0]["ls"], "carrier": items[0]["carrier"],
            "updated": items[0]["updated"], "tonnes": hold - remaining,
            "short": remaining, "trip_minutes": mins, "total": total,
            "cr_per_min": round(total / mins), "mix": mix,
        })
    plans.sort(key=lambda x: -x["cr_per_min"])
    return plans



