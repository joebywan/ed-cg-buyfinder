# Boxes the ship decides, not the commander. While a journal names a ship
# these follow it and are not editable; the rest of the toolbar is preference.
SHIP_KEYS = ("hold", "jump_empty", "jump_laden")


def ship_params(ship, cargo_capacity, max_jump_range, laden):
    """The toolbar values a detected ship implies, as strings.

    Only what the journal actually stated: a missing figure leaves that box
    alone rather than inventing one.
    """
    if not ship:
        return {}
    out = {}
    if cargo_capacity:
        out["hold"] = str(int(cargo_capacity))
    if max_jump_range:
        out["jump_empty"] = "%.1f" % max_jump_range
    if laden:
        out["jump_laden"] = "%.1f" % laden
    return out


def days_old(datestr):
    """Whole days since an ISO date, or None if we have no date."""
    if not datestr:
        return None
    try:
        y, m, d = (int(x) for x in datestr.split("-"))
    except ValueError:
        return None
    import datetime
    return (datetime.date.today() - datetime.date(y, m, d)).days


def age_text(datestr):
    n = days_old(datestr)
    if n is None:
        return "?"
    return "today" if n < 1 else "%dd ago" % n


def age_tag(datestr):
    n = days_old(datestr)
    if n is None:
        return "age_old"
    return ("age_ok" if n <= AGE_FRESH_DAYS
            else "age_mid" if n <= AGE_STALE_DAYS else "age_old")


class Tip:
    """Hover help. tkinter has no tooltips, and a settings dialog full of
    unexplained jargon is worse than one with fewer options."""

    def __init__(self, widget, text, app):
        self.widget, self.text, self.app, self.win = widget, text, app, None
        widget.bind("<Enter>", self._show, add="+")
        widget.bind("<Leave>", self._hide, add="+")
        widget.bind("<ButtonPress>", self._hide, add="+")

    def _show(self, _e=None):
        if self.win or not self.text:
            return
        x = self.widget.winfo_rootx() + 12
        y = self.widget.winfo_rooty() + self.widget.winfo_height() + 6
        self.win = tk.Toplevel(self.widget)
        self.win.wm_overrideredirect(True)
        self.win.wm_geometry("+%d+%d" % (x, y))
        tk.Label(self.win, text=self.text, justify="left", bg="#1c1610",
