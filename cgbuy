def _config_dir():
    """Per-platform config location. XDG_CONFIG_HOME always wins if set."""
    env = os.environ.get("XDG_CONFIG_HOME")
    if env:
        return env
    if sys.platform == "win32":
        return os.environ.get("APPDATA") or os.path.expanduser("~/AppData/Roaming")
    if sys.platform == "darwin":
        return os.path.expanduser("~/Library/Application Support")
    return os.path.expanduser("~/.config")


def _cache_dir():
    env = os.environ.get("XDG_CACHE_HOME")
    if env:
        return env
    if sys.platform == "win32":
        return (os.environ.get("LOCALAPPDATA")
                or os.path.expanduser("~/AppData/Local"))
    if sys.platform == "darwin":
        return os.path.expanduser("~/Library/Caches")
    return os.path.expanduser("~/.cache")


CONFIG_PATH = os.path.join(_config_dir(), "cgbuy.json")

CACHE_PATH = os.path.join(_cache_dir(), "cgbuy-results.json")


def save_cache(payload):
    """Keep the last search so the app opens with data instead of a blank grid."""
    try:
        os.makedirs(os.path.dirname(CACHE_PATH), exist_ok=True)
        tmp = CACHE_PATH + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(payload, fh)
        os.replace(tmp, CACHE_PATH)     # atomic: never leave a torn file
    except OSError:
        pass


def load_cache():
    try:
        with open(CACHE_PATH) as fh:
            d = json.load(fh)
        if isinstance(d, dict) and d.get("rows"):
            return d
    except (OSError, ValueError):
        pass
    return None


def cache_age_minutes(stamp):
    """Minutes since the cache was written, or None if unknown."""
    try:
        return max(0.0, (time.time() - float(stamp)) / 60.0)
    except (TypeError, ValueError):
        return None


def _dhm(hours):
    """'5d 3h' / '7h' - compact enough for a tooltip line."""
    d, rem = divmod(int(hours), 24)
    return "%dd %dh" % (d, rem) if d else "%dh" % rem


def age_phrase(stamp):
    """'3 minutes', '2 hours' - for the refresh prompt."""
    try:
        secs = max(0, int(time.time() - float(stamp)))
    except (TypeError, ValueError):
        return "an unknown time"
    if secs < 90:
        return "%d seconds" % secs
    if secs < 5400:
        m = round(secs / 60.0)
        return "%d minute%s" % (m, "" if m == 1 else "s")
    if secs < 172800:
        h = round(secs / 3600.0)
        return "%d hour%s" % (h, "" if h == 1 else "s")
    d = round(secs / 86400.0)
    return "%d day%s" % (d, "" if d == 1 else "s")


