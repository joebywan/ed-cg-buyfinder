    def _check_new_best(self, plans):
        """Tell the user when the top target changes.

        The window normally sits behind the game, so a silently better option
        is one they will not act on until they arrive somewhere drained.
        """
        if not plans:
            return
        top = plans[0]
        key = (top["station"], top["system"])
        if self.last_best is None:          # first search of the session
            self.last_best = key
            return
        if key == self.last_best:
            return
        self.last_best = key
        mix = " + ".join("%dt %s" % (m["tonnes"], m["commodity"])
                         for m in top.get("mix", [])[:3])
        self._notify(
            "New best: %s" % top["station"],
            "%s  -  %.1f ly, %s Ls\n%s\n%s cr per ~%d min"
            % (top["system"], top["ly"], f"{top['ls']:,}", mix,
               f"{top['total']:,}", round(top["trip_minutes"])))

    def _check_band_change(self, st):
        """Reward bands move both ways - others delivering can push you down."""
        band = st.get("band")
        if band is None:
            return
        if self.last_band is None:
            self.last_band = band
            return
        if band == self.last_band:
            return
        was, self.last_band = self.last_band, band
        if band < was:                      # smaller number = better band
            self._notify("Moved up to the top %s%%" % band,
                         "Was top %s%%. %st delivered."
                         % (was, f"{st['contribution']:,}"), "normal")
        else:
            self._notify("Dropped to the top %s%%" % band,
                         "Was top %s%%. Others have overtaken you - "
                         "%st delivered so far."
                         % (was, f"{st['contribution']:,}"), "high")

    def _tick_age(self):
        """Keep 'updated N ago' honest without waiting for the next search.

        Auto-refresh fires on docking at the destination; without a visible
        clock there is no way to tell whether it actually ran.
        """
        if self.closing:
            return
        if self.busy:
            self.fetch_lbl.configure(text="updating now...", foreground=OR)
        elif self.last_fetch:
            mins = cache_age_minutes(self.last_fetch)
            if mins is None:
                self.fetch_lbl.configure(text="")
            else:
                stale = mins >= int(self.cfg.get("cache_fresh_minutes",
                                                 CACHE_FRESH_MINUTES))
                self.fetch_lbl.configure(
                    text="updated %s ago" % age_phrase(self.last_fetch),
                    foreground=WARN if stale else GOOD)
        else:
            self.fetch_lbl.configure(text="not updated yet", foreground=DIM)
        self.root.after(15000, self._tick_age)

