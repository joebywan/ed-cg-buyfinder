# Where you sell, and what that place pays well for. Defaults to the goal
# this tool was written for so an existing install keeps working, but nothing
# downstream assumes it - the destination travels through build_rows in the
# params dict.
# Deliberately empty. The destination is discovered from the journal - the
# community goal this commander joined - and only asked for if that fails.
# Shipping one player's goal as everyone's default was the bug this replaces.
DEFAULT_DEST = {
    "station": None, "system": None, "commodities": [],
    "title": None, "expiry": None, "source": "none",
}


def window_title(dest):
    """Title bar text: the place results are ranked against, if there is one."""
    d = dest or {}
    place = ", ".join(p for p in (d.get("station"), d.get("system")) if p)
    return "CG Buy Finder - %s" % place if place else "CG Buy Finder"

# A destination station's own market gives away which goods it pays a premium
# for: a CG sells at a fixed multiple of galactic mean price, far above any
# ordinary market's spread.
CG_PRICE_RATIO = 2.5


def derive_commodities(market_items):
    """Pick the premium-paying goods from a station's own market.

    `market_items` is Market.json's Items list, which carries MeanPrice.
    Returns [] when there is no clear premium, so callers fall back rather
    than acting on noise.
    """
    out = []
    for it in market_items or []:
        mean = it.get("MeanPrice") or 0
        sell = it.get("SellPrice") or 0
        if mean and sell and sell / mean >= CG_PRICE_RATIO:
            out.append(it.get("Name_Localised") or it.get("Name") or "")
    return sorted(n for n in out if n)

SPANSH_SEARCH = "https://spansh.co.uk/api/stations/search"
EDSM_MARKET = ("https://www.edsm.net/api-system-v1/stations/market"
               "?systemName={sys}&stationName={stn}")
EDSM_STATIONS = "https://www.edsm.net/api-system-v1/stations?systemName={sys}"
AGENT = "cgbuy/2.0 (personal ED trade helper)"


