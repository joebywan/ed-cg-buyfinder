#!/usr/bin/env python3
"""
cgbuy-next - one Stream Deck button's worth of behaviour.

Bind this to a single button in OpenDeck (or any deck software, or a hotkey).
It does NOT touch the Stream Deck hardware - your existing setup keeps full
control of the device, and it never sends input to the game.

On each press it:
  1. reads the current best buy target (written by the cgbuy app),
  2. prints it,
  3. advances to the next target so the following press moves you on.

It prints the target on stdout, so deck software that can show command output
will display it on the button face.

Usage:
  cgbuy-next              # show the current target, then advance
  cgbuy-next --peek       # show the current target, change nothing
  cgbuy-next --reset      # go back to the top-ranked target

From an OpenDeck (flatpak) button, run:
  flatpak-spawn --host /path/to/cgbuy-next
"""

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

STATE_PATH = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "cgbuy-state.json")

def load_state():
    try:
        with open(STATE_PATH) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def save_index(idx):
    """Update only the index.

    Rewriting the whole document would clobber a fresher plan list that the
    app may have published in the meantime.
    """
    try:
        st = load_state() or {}
        st["index"] = idx
        os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
        tmp = STATE_PATH + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(st, fh, indent=2)
        os.replace(tmp, STATE_PATH)
    except OSError:
        pass


def age_text(datestr):
    """Days since the market was last reported, for the button face."""
    if not datestr:
        return "age ?"
    try:
        y, m, d = (int(x) for x in datestr.split("-"))
    except (ValueError, AttributeError):
        return "age ?"
    import datetime
    n = (datetime.date.today() - datetime.date(y, m, d)).days
    return "today" if n < 1 else "%dd old" % n


def describe(plan, idx, total):
    # The whole mix, not the first two: a truncated list means you undercarry.
    mix = " + ".join("%dt %s" % (m["tonnes"], m["commodity"])
                     for m in plan.get("mix", []))
    tonnes = plan.get("tonnes")
    short = plan.get("short") or 0
    load = ("%st%s" % (f"{tonnes:,}", "  (%dt short)" % short if short else "")
            if tonnes else "")
    trip = plan.get("trip_minutes")
    return "\n".join([
        "%s" % plan["station"],
        "%s" % plan["system"],
        mix,
        load,
        "%.1f ly  %s Ls%s" % (plan["ly"], f"{plan['ls']:,}",
                              "  ~%dm" % round(trip) if trip else ""),
        "%.1fM cr  %s  (%d/%d)" % (plan.get("total", 0) / 1e6,
                                   age_text(plan.get("updated")), idx + 1, total),
    ])


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--peek", action="store_true", help="print only")
    ap.add_argument("--reset", action="store_true", help="back to rank 1")
    a = ap.parse_args()

    cfg_path = os.path.join(
        os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
        "cgbuy.json")
    try:
        with open(cfg_path) as fh:
            if not json.load(fh).get("deck_enabled", True):
                print("deck button disabled\nenable it in the cgbuy app")
                return 1
    except (OSError, ValueError):
        pass

    st = load_state()
    if not st or not st.get("plans"):
        print("no targets\nrun the cgbuy app")
        return 1

    plans = st["plans"]
    if a.reset:
        save_index(0)
        st["index"] = 0

    idx = min(st.get("index", 0), len(plans) - 1)
    plan = plans[idx]

    if a.peek:
        print(describe(plan, idx, len(plans)))
        return 0

    save_index((idx + 1) % len(plans))
    print(describe(plan, idx, len(plans)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
