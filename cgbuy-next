#!/usr/bin/env python3
"""
cgbuy-next - one Stream Deck button's worth of behaviour.

Bind this to a single button in OpenDeck (or any deck software, or a hotkey).
It does NOT touch the Stream Deck hardware - your existing setup keeps full
control of the device.

On each press it:
  1. reads the current best buy target (written by the cgbuy app),
  2. types that system name into Elite's focused text field,
  3. advances to the next target so the following press moves you on.

It prints the target on stdout, so deck software that can show command output
will display it on the button face.

Usage:
  cgbuy-next              # send current target to Elite, then advance
  cgbuy-next --peek       # print the current target, change nothing
  cgbuy-next --reset      # go back to the top-ranked target
  cgbuy-next --no-type    # advance + print, but never touch Elite

From an OpenDeck (flatpak) button, run:
  flatpak-spawn --host /path/to/cgbuy-next
"""

import argparse
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

STATE_PATH = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "cgbuy-state.json")

ELITE_PATTERNS = ["Elite - Dangerous (CLIENT)", "Elite - Dangerous"]


def run(args, timeout=5):
    try:
        p = subprocess.run(args, capture_output=True, timeout=timeout, text=True)
        return p.returncode, p.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return 1, ""


def load_state():
    try:
        with open(STATE_PATH) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def save_state(st):
    try:
        os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
        with open(STATE_PATH, "w") as fh:
            json.dump(st, fh, indent=2)
    except OSError:
        pass


def find_elite():
    if not run(["which", "xdotool"])[0] == 0:
        return None
    for pat in ELITE_PATTERNS:
        rc, out = run(["xdotool", "search", "--name", pat])
        if rc == 0 and out:
            return out.split("\n")[-1].strip()
    return None


def type_into_elite(text):
    """Open the galaxy map and search for `text`.

    Uses the shared closed-loop plotter when available: it confirms via
    Status.json that the map actually opened before typing, so a mistimed
    press cannot dump a system name onto the flight controls.
    """
    try:
        import plot, journal
    except ImportError:
        plot = None
    if plot is not None:
        jd = journal.find_journal_dir()
        gm = plot.galaxy_map_key(plot.find_binds_file())
        if jd and gm:
            ok, msg, _log = plot.plot_route(text, jd, gm)
            return ok, msg
    win = find_elite()
    if not win:
        return False, "Elite window not found"
    run(["xdotool", "windowactivate", "--sync", win])
    rc, _ = run(["xdotool", "type", "--clearmodifiers", "--window", win,
                 "--delay", "25", text], timeout=15)
    return rc == 0, ("typed" if rc == 0 else "xdotool type failed")


def describe(plan, idx, total):
    mix = " + ".join("%dt %s" % (m["tonnes"], m["commodity"])
                     for m in plan.get("mix", [])[:2])
    return "\n".join([
        "%s" % plan["station"],
        "%s" % plan["system"],
        mix,
        "%.1f ly  %s Ls" % (plan["ly"], f"{plan['ls']:,}"),
        "%.1fM cr  (%d/%d)" % (plan.get("total", 0) / 1e6, idx + 1, total),
    ])


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--peek", action="store_true", help="print only")
    ap.add_argument("--reset", action="store_true", help="back to rank 1")
    ap.add_argument("--no-type", action="store_true", help="never touch Elite")
    a = ap.parse_args()

    cfg_path = os.path.join(
        os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
        "cgbuy.json")
    try:
        with open(cfg_path) as fh:
            if not json.load(fh).get("deck_enabled", True):
                print("deck button disabled\nenable it in the cgbuy app")
                return 1
    except (OSError, ValueError):
        pass

    st = load_state()
    if not st or not st.get("plans"):
        print("no targets\nrun the cgbuy app")
        return 1

    plans = st["plans"]
    if a.reset:
        st["index"] = 0
        save_state(st)

    idx = min(st.get("index", 0), len(plans) - 1)
    plan = plans[idx]

    if a.peek:
        print(describe(plan, idx, len(plans)))
        return 0

    note = ""
    if not a.no_type:
        ok, msg = type_into_elite(plan["system"])
        note = "" if ok else "  [%s]" % msg

    st["index"] = (idx + 1) % len(plans)
    save_state(st)

    print(describe(plan, idx, len(plans)) + note)
    return 0


if __name__ == "__main__":
    sys.exit(main())
